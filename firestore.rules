rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 64;
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Customer accounts collection keyed by normalized phone digits
    match /customers/{phoneId} {
      allow read: if true;
      allow create, update: if isValidId(phoneId);
      allow delete: if false;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if isValidId(orderId) &&
        (!('recycle' in request.resource.data) ||
         request.resource.data.recycle == null ||
         (
           request.resource.data.recycle.actualKg == null ||
           (request.resource.data.recycle.actualKg is number && request.resource.data.recycle.actualKg >= 0)
         ));
      allow delete: if false;
    }

    // Notifications collection
    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if isValidId(notifId);
      allow delete: if false;
    }

    // Couriers collection
    match /couriers/{courierId} {
      allow read: if true;
      allow create, update: if isValidId(courierId);
      allow delete: if false;
    }

    // Plans collection
    match /plans/{planId} {
      allow read: if true;
      allow create, update: if isValidId(planId);
      allow delete: if false;
    }

    // Promos collection
    match /promos/{promoId} {
      allow read: if true;
      allow create, update: if isValidId(promoId);
      allow delete: if false;
    }

    // Operational costs collection
    match /operationalCosts/{costId} {
      allow read: if true;
      allow create, update: if isValidId(costId);
      allow delete: if false;
    }

    // System users collection
    match /systemUsers/{userId} {
      allow read: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // System roles collection - Weighing is strictly forbidden for admin roles
    match /systemRoles/{roleId} {
      allow read: if true;
      allow create, update: if isValidId(roleId) &&
        (roleId != 'super_admin' && roleId != 'admin_operasional' ||
         !('orders_weigh' in request.resource.data.permissions));
      allow delete: if false;
    }

    // Stamp history per customer
    match /stampHistory/{stampId} {
      allow read: if true;
      allow create, update: if isValidId(stampId);
      allow delete: if false;
    }

    // Customer vouchers per customer
    match /customerVouchers/{voucherId} {
      allow read: if true;
      allow create, update: if isValidId(voucherId);
      allow delete: if false;
    }

    // System and program settings (e.g. recycleProgram, impactStats)
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if false;
    }

    // Artisans collection for Laundrea Peduli
    match /artisans/{artisanId} {
      allow read: if true;
      allow create, update: if isValidId(artisanId);
      allow delete: if false;
    }

    // Recycle works showcase collection
    match /recycleWorks/{workId} {
      allow read: if true;
      allow create, update: if isValidId(workId);
      allow delete: if false;
    }
  }
}
