rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() >= 5 && id.size() <= 30 && id.matches('^[0-9]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidCustomer(data, phoneId) {
      return data.keys().hasAll(['name', 'address', 'phone'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.address is string && data.address.size() >= 1 && data.address.size() <= 500
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Customer accounts collection keyed by normalized phone digits
    match /customers/{phoneId} {
      // Allow get for individual check and list for Admin customer directory
      allow get: if isValidId(phoneId);
      allow list: if true;

      // Allow creating account if valid id and valid customer schema
      allow create: if isValidId(phoneId) && isValidCustomer(incoming(), phoneId);

      // Allow updating profile (e.g. name or address changes)
      allow update: if isValidId(phoneId) && isValidCustomer(incoming(), phoneId);

      allow delete: if false;
    }
  }
}
